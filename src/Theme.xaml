  <ControlTemplate x:Key="HorizontalSlider" TargetType="Slider">
    <Grid Background="Transparent" Margin="0,2" MinHeight="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TickBar x:Name="TopTicks" Grid.Row="0" Height="4" Fill="#6B8796" Placement="Top" Visibility="Collapsed" ReservedSpace="17" />
      <Border x:Name="Focus" Grid.Row="1" BorderBrush="{StaticResource FocusBorder}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False" />
      <Track x:Name="PART_Track" Grid.Row="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource SliderPage}" Command="{x:Static Slider.DecreaseLarge}" Background="{TemplateBinding Foreground}" Height="5" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource SliderThumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource SliderPage}" Command="{x:Static Slider.IncreaseLarge}" Background="{TemplateBinding Background}" Height="5" />
        </Track.IncreaseRepeatButton>
      </Track>
      <TickBar x:Name="BottomTicks" Grid.Row="2" Height="4" Fill="#6B8796" Placement="Bottom" Visibility="Collapsed" ReservedSpace="17" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft">
        <Setter TargetName="TopTicks" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight">
        <Setter TargetName="BottomTicks" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="Both">
        <Setter TargetName="TopTicks" Property="Visibility" Value="Visible" />
        <Setter TargetName="BottomTicks" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.42" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="VerticalSlider" TargetType="Slider">
    <Grid Background="Transparent" MinWidth="24">
      <Border x:Name="Focus" BorderBrush="{StaticResource FocusBorder}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False" />
      <Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource SliderPage}" Command="{x:Static Slider.DecreaseLarge}" Background="{TemplateBinding Foreground}" Width="5" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource SliderThumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource SliderPage}" Command="{x:Static Slider.IncreaseLarge}" Background="{TemplateBinding Background}" Width="5" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.42" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="#20E494" />
    <Setter Property="Background" Value="#344854" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource HorizontalSlider}" />
