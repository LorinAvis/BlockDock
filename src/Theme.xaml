          <Border x:Name="Grip" Background="#526976" CornerRadius="4" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Background" Value="#8CA9B7" />
